        uniform token purpose = "guide"
        uniform token subdivisionScheme = "none"
    }

    def "Looks"
    {
        def Material "Scan"
        {
            token outputs:surface.connect = </Bowl/Looks/Scan/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Bowl/Looks/Scan/Texture.outputs:rgb>
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./bowl_texture.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Bowl/Looks/Scan/StReader.outputs:result>
                float3 outputs:rgb
            }

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }
    }
}

